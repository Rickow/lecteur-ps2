+	function("getIopUsage", &getIopUsage);
 	function("clearStats", &clearStats);
+	function("saveState", &saveState);
+	function("loadState", &loadState);
+	function("setResolutionFactor", &setResolutionFactor);
+	function("setFrameLimiter", &setFrameLimiter);
 }
